{
  "name": "polyxslt",
  "version": "1.0.0",
  "description": "A small XSLT 1.0 polyfill for browsers without native XSLT",
  "keywords": [
    "xslt",
    "xslt-1.0",
    "xpath",
    "polyfill",
    "rss",
    "atom",
    "sitemap",
    "xsltprocessor"
  ],
  "license": "MIT",
  "author": "Xin LI <delphij@FreeBSD.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delphij/polyxslt.git"
  },
  "homepage": "https://github.com/delphij/polyxslt#readme",
  "bugs": {
    "url": "https://github.com/delphij/polyxslt/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/polyxslt.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/polyxslt.mjs"
    },
    "./dev": {
      "types": "./dist/index.d.ts",
      "import": "./dist/dev/polyxslt.mjs"
    },
    "./xslt-polyfill.min.js": "./dist/xslt-polyfill.min.js",
    "./dev/xslt-polyfill.js": "./dist/dev/xslt-polyfill.js"
  },
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/xslt-polyfill.min.js",
  "jsdelivr": "./dist/xslt-polyfill.min.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --dev && node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "golden": "node scripts/golden.mjs",
    "golden:check": "node scripts/golden.mjs && git diff --exit-code -- test/fixtures test/xpath",
    "size": "size-limit",
    "verify:private": "node scripts/verify-private.mjs",
    "docs:check": "node scripts/docs.mjs && git diff --exit-code -- docs/SUPPORTED.md docs/ERRORS.md",
    "docs:gen": "node scripts/docs.mjs",
    "sri": "node scripts/sri.mjs",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && pnpm size && pnpm golden:check && pnpm docs:check",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul --coverage.include=src/** --coverage.exclude=src/host/auto.ts --coverage.reporter=text-summary",
    "release": "node scripts/release.mjs"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^26.6.3",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-istanbul": "^5.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "playwright": "^1.63.0",
    "size-limit": "^14.1.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "size-limit": [
    {
      "name": "auto (IIFE)",
      "path": "dist/xslt-polyfill.min.js",
      "limit": "11 kB"
    },
    {
      "name": "ESM",
      "path": "dist/polyxslt.mjs",
      "limit": "11 kB"
    }
  ]
}
