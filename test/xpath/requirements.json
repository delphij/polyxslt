  "cases": [
    {
      "expr": "count(s:urlset/s:url)"
    },
    {
      "expr": "count(s:urlset/s:url[contains(s:loc, '/posts/')])"
    },
    {
      "expr": "count(s:urlset/s:url[not(contains(s:loc, '/posts/')) and not(contains(s:loc, '/tags/'))])"
    },
    {
      "expr": "substring-after(substring-after(s:urlset/s:url[1]/s:loc, '://'), '/')"
    },
    {
      "expr": "contains(substring-after(s:urlset/s:url[2]/s:loc, '://'), '/')"
    },
    {
      "expr": "substring(s:urlset/s:url[1]/s:lastmod, 1, 10)"
    },
    {
      "expr": "substring(s:urlset/s:url[1]/s:lastmod, 12, 5)"
    },
    {
      "expr": "string-length(s:urlset/s:url[2]/s:lastmod) >= 16"
    },
    {
      "expr": "xhtml:link[@href = $url]/@hreflang",
      "nodes": true,
      "ctx": "s:urlset/s:url[1]",
      "vars": {
        "url": "s:loc"
