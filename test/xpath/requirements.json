      }
    },
    {
      "expr": "starts-with($url, $base)",
      "ctx": "s:urlset/s:url[1]",
      "vars": {
        "url": "s:loc",
        "base": "'https://example.org'"
      }
    },
    {
      "expr": "substring-after($url, $base)",
      "ctx": "s:urlset/s:url[1]",
      "vars": {
        "url": "s:loc",
        "base": "'https://example.org'"
      }
    },
