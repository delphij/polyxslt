<?xml version="1.0" encoding="UTF-8"?>
<!-- Benchmark stylesheet: exercises XPath evaluation, patterns, sorting and copying rather
     than output.  The input is generated by scripts/bench.mjs. -->
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0">
  <xsl:output method="xml" encoding="UTF-8"/>
  <xsl:variable name="rate" select="1.25"/>
  <xsl:variable name="kinds" select="/catalog/kinds/kind"/>

  <xsl:template match="/">
    <xsl:variable name="all" select="//item"/>
    <report items="{count($all)}" total="{sum(//item/@price)}" title="{catalog/@title}">
      <sample>
        <xsl:for-each select="//item[@kind = 'a'][position() mod 7 = 1]">
          <pick id="{@id}" last="{position() = last()}"/>
        </xsl:for-each>
      </sample>
      <kinds>
        <xsl:for-each select="$kinds">
          <xsl:variable name="k" select="@code"/>
          <kind code="{$k}" items="{count($all[@kind = $k])}">
            <xsl:value-of select="normalize-space(.)"/>
          </kind>
        </xsl:for-each>
      </kinds>
      <xsl:apply-templates select="catalog/section"/>
    </report>
  </xsl:template>

  <xsl:template match="section">
    <section name="{@name}" cheapest="{item[not(../item/@price &lt; @price)][1]/@id}">
      <xsl:for-each select="item">
        <xsl:sort select="@price" data-type="number" order="descending"/>
        <xsl:sort select="name"/>
        <xsl:variable name="cost" select="@price * @qty * $rate"/>
        <row id="{@id}" n="{position()}" of="{last()}" before="{count(preceding-sibling::item)}"
             next="{following-sibling::item[1]/name}" in="{../@name}" root="{ancestor::catalog/@title}">
          <xsl:attribute name="cost">
            <xsl:value-of select="round($cost * 100) div 100"/>
          </xsl:attribute>
          <xsl:if test="tag = ../item[1]/tag">
            <xsl:attribute name="shared">yes</xsl:attribute>
          </xsl:if>
          <label>
            <xsl:value-of select="concat(translate(name, 'abcdefghij', 'ABCDEFGHIJ'), ' (', tag[last()], ')')"/>
          </label>
          <xsl:choose>
            <xsl:when test="$cost &gt; 400 and @kind != 'c'">
              <high len="{string-length(normalize-space(note))}"/>
            </xsl:when>
            <xsl:when test="starts-with(name, 'item 1') or contains(note, 'seven')">
              <mid>
                <xsl:value-of select="substring-before(substring-after(note, ' '), ' ')"/>
              </mid>
            </xsl:when>
            <xsl:otherwise>
              <low/>
            </xsl:otherwise>
          </xsl:choose>
          <xsl:apply-templates select="tag | note"/>
        </row>
      </xsl:for-each>
    </section>
  </xsl:template>

  <xsl:template match="section/item[@kind = 'b']/tag" priority="2">
    <b-tag>
      <xsl:value-of select="."/>
    </b-tag>
  </xsl:template>

  <xsl:template match="tag[1]">
    <first-tag>
      <xsl:value-of select="."/>
    </first-tag>
  </xsl:template>

  <xsl:template match="tag">
    <tag pos="{position()}">
      <xsl:value-of select="."/>
    </tag>
  </xsl:template>

  <xsl:template match="note">
    <note>
      <xsl:choose>
        <xsl:when test="../@kind = 'c'">
          <xsl:copy-of select="node()"/>
        </xsl:when>
        <xsl:otherwise>
          <xsl:apply-templates/>
        </xsl:otherwise>
      </xsl:choose>
    </note>
  </xsl:template>

  <xsl:template match="note//em">
    <strong>
      <xsl:apply-templates/>
    </strong>
  </xsl:template>
</xsl:stylesheet>
